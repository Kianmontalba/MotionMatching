; Engine configuration file.
; This is a minimal project.godot for the Motion Matching demo.
; It only defines what the demo's own scripts/scenes require:
; the main scene and the 6 input actions player.gd reads from.

config_version=5

[application]

config/name="Motion Matching Demo"
run/main_scene="res://demo_scene.tscn"
config/features=PackedStringArray("4.3")
config/icon=""

